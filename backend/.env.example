NODE_ENV=production
APP_VERSION=0.5.0
PORT=4000

# Produccion empresarial: usa un rol limitado, NO el usuario postgres ni service_role.
# Crea el rol con backend/sql/app-api-role.sql y usa esa contrasena aqui.
DATABASE_URL=postgresql://app_api:PASSWORD@HOST:6543/postgres
DATABASE_SSL=true
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Solo para Supabase Storage/backups desde backend. Nunca en frontend.
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY_SECRETA

FRONTEND_ORIGIN=https://TU-SITIO.vercel.app
FRONTEND_ORIGINS=https://TU-SITIO.vercel.app
COOKIE_SECURE=true
REQUIRE_HTTPS=true
SESSION_MINUTES=30
MAX_UPLOAD_MB=25
PASSWORD_RESET_MINUTES=20
JWT_SECRET=CAMBIA_ESTE_SECRETO_LARGO_Y_ALEATORIO

# Anti-bot real: usa turnstile o recaptcha.
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SITE_KEY=TU_SITE_KEY_PUBLICA
CAPTCHA_SECRET_KEY=TU_SECRET_KEY_PRIVADA
CAPTCHA_REQUIRED=true

# MFA obligatorio para administradores.
MFA_REQUIRED_ROLES=admin

# Alertas: Slack/Teams/Discord webhook compatible con JSON.
ALERT_WEBHOOK_URL=https://hooks.example.com/seguridad
ALERT_MIN_LEVEL=high
MAX_IP_CHANGES_PER_SESSION=2
MAX_SUSPICIOUS_SESSIONS_PER_USER=3

# Backups automaticos con pg_dump + Supabase Storage.
BACKUP_BUCKET=backups
BACKUP_RETENTION_DAYS=30
PG_DUMP_PATH=pg_dump

# En modo empresarial las migraciones DDL se ejecutan manualmente en Supabase SQL Editor.
RUN_MIGRATIONS=false
